namespace Stride.Rendering.Materials.Shaders
{
    /// <summary>
    /// Outputs the specular reflection of the environment lights that the shading added to the color
    /// </summary>
    shader GBufferOutputEnvironmentSpecular : ComputeColor, MaterialPixelShadingStream
    {
        override float4 Compute()
        {
            return float4(streams.shadingEnvironmentSpecular, 1);
        }
    };
}
